# Copie para apps/server/.env (ignorado pelo git). `npm run dev` carrega este arquivo;
# variáveis já definidas no ambiente valem mais que as do arquivo. Detalhes: README.md › Configuração.

# Rede e acesso
PORT=4000
HOST=127.0.0.1
# Obrigatório quando HOST não é loopback (ex.: HOST=0.0.0.0)
MAESTRI_TOKEN=
# ALLOWED_ORIGINS=http://localhost:3000

# Projeto e dados
# REPO_PATH=
# MAESTRI_PROJECTS_DIR=~/maestri-projects
# SHELL=/bin/bash

# Instruções do canvas para os agentes (0 = não instala a skill maestri-web nas pastas globais dos CLIs)
# MAESTRI_AGENT_CONTEXT=1

# Portais (Chromium headless)
# MAESTRI_PORTAL_ALLOW_PRIVATE=1
# MAESTRI_PORTAL_NO_SANDBOX=1
# MAESTRI_PORTAL_FRAME_MS=150

# Tempos (ms)
# MAESTRI_ASK_QUIET_MS=5000
# MAESTRI_WAKE_STARTUP_MS=30000
# MAESTRI_WAKE_SETTLE_MS=1500
# MAESTRI_PR_POLL_MS=120000
# MAESTRI_ROUTINE_TICK_MS=15000
# MAESTRI_ROUTINE_BUSY_MS=5000
# MAESTRI_ROUTINE_PRERUN_MS=30000

# Notificações do sistema (1/0; sem a variável vale a preferência do projeto)
# MAESTRI_DESKTOP_NOTIFY=
